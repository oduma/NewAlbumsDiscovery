{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Heartbeat": {
    "IntervalSeconds": 60
  },
  "NewAlbumsDiscovery": {
    "Aggregator": {
      "CountryRegionThreshold": 10,
      "CountryRegionLanguageThreshold": 10,
      "MinimumBucketThreshold": 2
    }
  }
}
