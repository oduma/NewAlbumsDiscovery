{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Heartbeat": {
    "IntervalSeconds": 60
  },
  "NewAlbumsDiscovery": {
    "Aggregator": {
      "CountryRegionThreshold": 10,
      "CountryRegionLanguageThreshold": 10,
      "MinimumBucketThreshold": 2
    },
    "Gemini": {
      "Model": "gemini-1.5-flash"
    },
    "CoreOperations": {
      "TriggerDelaySeconds": 30
    },
    "AIDiscovery": {
      "InterBucketDelaySeconds": 10,
      "MaxAlbumsPerQuery": 20
    }
  }
}
